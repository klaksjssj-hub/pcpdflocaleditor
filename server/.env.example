# localpdf Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# File Upload and Processing
MAX_FILE_SIZE=104857600
FILE_RETENTION_HOURS=24
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed

# Database Configuration (Optional PostgreSQL)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/localpdf
DB_PATH=./data/metadata.json

# AWS S3 Production Storage (Optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=my-pdf-bucket
